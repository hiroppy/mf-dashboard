{
  "name": "@mf-dashboard/analytics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chat/cards": "./src/chat/cards.ts",
    "./chat/tools": "./src/chat/tools.ts",
    "./config": "./src/config.ts",
    "./categorization": "./src/categorization.ts",
    "./tools/analysis": "./src/insights/analysis-tools.ts",
    "./tools/financial": "./src/insights/tools.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "eval:chat": "pnpm --filter @mf-dashboard/db build:demo --period=2026-07 && PROMPTFOO_DISABLE_TELEMETRY=1 DB_PATH=../../data/demo.db promptfoo eval --config=evals/promptfooconfig.yaml --no-cache",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:demo-insights": "DB_PATH=../../data/demo.db tsx --env-file=../../.env scripts/generate-demo-insights.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.15",
    "@ai-sdk/google": "4.0.17",
    "@ai-sdk/openai": "4.0.15",
    "@mf-dashboard/date-utils": "workspace:*",
    "@mf-dashboard/db": "workspace:*",
    "ai": "7.0.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "promptfoo": "0.121.19",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
